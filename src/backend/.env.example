# Base de datos
DATABASE_URL=postgresql+asyncpg://usuario:contraseña@localhost:5432/nombre_base_de_datos


# Estado de la aplicacion solo en local 
DEBUG=True

# JWT / Autenticación
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
